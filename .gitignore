# dépendances et environnements, réinstallables
node_modules/
backend/.venv/
server/.venv/
__pycache__/
*.pyc

# constructions, régénérables
dist/
out/
release/
backend/build/
backend/dist/
renderer/dist/
site/telechargement/

# secrets et données locales : ne doivent JAMAIS être versionnés
.env
*.env
server/.env
*.db
*.sqlite*

# journaux et fichiers de travail
*.log
vite-dev.log
release/

# donnees de developpement locales
backend/dev-data/

# outils binaires du serveur (cloudflared, WinSW) : gros, telechargeables, jamais versionnes
serveur/outils/
serveur/*-service.exe
serveur/journaux/
serveur/donnees/

# relais en service : compteurs, journaux, binaire du superviseur
serveur/relais-service.exe
serveur/.venv/

# voix Piper (modèles binaires, ~60 Mo) : téléchargeables, jamais versionnés
backend/piper_voices/
