# ---------------------------------------------------------------------------
# Serveur de licences VELA — modèle de configuration.
#
# Copiez ce fichier en « .env » et remplissez-le. Le fichier .env est exclu par
# .gitignore : il ne doit JAMAIS être versionné ni envoyé par courriel.
# Chez un hébergeur (Render, Fly.io, Railway), ne déposez pas ce fichier :
# recopiez ces variables dans l'interface « Environment / Secrets ».
# ---------------------------------------------------------------------------

# --- Environnement ---------------------------------------------------------
# « developpement » (défaut) ou « production ».
# En production, le service REFUSE de démarrer si la vérification des signatures
# est désactivée ou si les identifiants PayPal manquent.
IRIS_ENV=developpement

# Saute la vérification de signature des webhooks. Sert uniquement à tester sans
# compte PayPal (envoi de faux webhooks avec curl). Interdit si IRIS_ENV=production.
# Laissez vide ou 0 partout ailleurs.
IRIS_WEBHOOK_SANS_VERIFICATION=0


# --- PayPal ----------------------------------------------------------------
# Tableau de bord développeur PayPal › Apps & Credentials › votre application.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Tableau de bord développeur PayPal › Webhooks : identifiant du webhook (WH-...).
# Sans lui, aucune signature ne peut être vérifiée.
PAYPAL_WEBHOOK_ID=
# « sandbox » pour les tests, « live » pour les vrais paiements.
PAYPAL_ENV=sandbox


# --- Clés d'abonnement -----------------------------------------------------
# Secret HMAC qui signe les clés IRIS-...
# IMPORTANT : il doit être IDENTIQUE à celui de l'application (backend/iris/plans.py,
# LICENSE_SECRET). Si vous le changez d'un seul côté, aucune clé ne sera reconnue.
# Laissé vide, le serveur reprend le secret historique « VELA-IRIS-2026-license-v1 »
# pour rester compatible avec les clés déjà distribuées. Voir le README.
IRIS_LICENSE_SECRET=


# --- Administration --------------------------------------------------------
# Jeton d'accès à /admin. Vide = page d'administration désactivée.
# Générez-le au hasard : python -c "import secrets; print(secrets.token_urlsafe(32))"
IRIS_JETON_ADMIN=


# --- Courriel (SMTP) -------------------------------------------------------
# Si IRIS_SMTP_HOTE est vide, les courriels sont écrits dans le dossier « sortie/ »
# au lieu d'être envoyés. Le service fonctionne quand même.
# Avec Gmail : hôte smtp.gmail.com, port 587, et un « mot de passe d'application »
# (pas le mot de passe du compte).
IRIS_SMTP_HOTE=
IRIS_SMTP_PORT=587
IRIS_SMTP_UTILISATEUR=
IRIS_SMTP_MOTDEPASSE=
IRIS_SMTP_TLS=1
IRIS_COURRIEL_EXPEDITEUR=VELA <miguelfreddy65@gmail.com>
IRIS_COURRIEL_SUPPORT=miguelfreddy65@gmail.com
# Destinataire des alertes (paiement non reconnu…). Vide = adresse de support.
IRIS_COURRIEL_ALERTE=


# --- Fichiers --------------------------------------------------------------
# Chemins de la base et du dossier de dépôt des courriels.
# Chez un hébergeur, pointez la base vers un disque persistant, sinon elle
# disparaît à chaque redéploiement (ex. Render : /var/data/licences.db).
IRIS_BASE=
IRIS_SORTIE=


# --- Limitation de débit ---------------------------------------------------
# Requêtes autorisées par adresse IP et par fenêtre (en secondes).
IRIS_LIMITE_REQUETES=20
IRIS_LIMITE_FENETRE=60
# Limite plus stricte sur /api/licence (anti-énumération des adresses courriel).
IRIS_LIMITE_LICENCE=10


# --- Montants --------------------------------------------------------------
# Devises acceptées, séparées par des virgules. Une devise absente de cette liste
# n'active jamais rien : le paiement part en traitement manuel.
IRIS_DEVISES=CAD
# Écart accepté entre le montant reçu et le prix affiché, en dollars.
IRIS_TOLERANCE_MONTANT=0.05
