# En-têtes Netlify de l'ANCIEN site téléphone d'IRIS (format : chemin, puis en-têtes indentés).
#
# ── État au 2026-09-14 : index.html remplacé par une page d'information ──
# L'ancienne page intégrait le widget vocal d'un fournisseur tiers ; elle est remplacée par une page sans
# script tiers ni identifiant d'agent, qui renvoie à la page téléphone servie par l'ordinateur (/m).
# « script-src 'self' » reste : aucun script d'un autre domaine ne peut revenir par erreur.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  # Ancien site, pas une page à trouver par un moteur de recherche.
  X-Robots-Tag: noindex, nofollow
  # Micro, caméra, position et écran allumé : cette origine seulement (plus aucun domaine de fournisseur).
  # Paiement et USB restent fermés. La page de référence reste /m, servie par l'ordinateur (README).
  Permissions-Policy: microphone=(self), camera=(self), geolocation=(self), screen-wake-lock=(self), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# L'agent de service ne doit JAMAIS être servi depuis le cache du navigateur : sinon une nouvelle
# version de l'app ne serait jamais prise en compte. On force la revalidation à chaque visite.
/sw.js
  Cache-Control: no-cache

# Le manifeste et le HTML : revalidation à chaque visite, pour que les mises à jour arrivent vite.
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Les icônes changent rarement : une journée de cache.
/icone-192.png
  Cache-Control: public, max-age=86400
/icone-512.png
  Cache-Control: public, max-age=86400

# Style et script : cache court. Incrémenter ?v= dans index.html reste la protection principale
# si un jour on veut forcer un rafraîchissement immédiat après un correctif.
/assets/*
  Cache-Control: public, max-age=3600
