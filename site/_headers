# En-têtes de sécurité (format Netlify : chemin, puis en-têtes indentés de deux espaces).
# Le site est entièrement statique et ne charge aucune ressource externe : la politique de
# sécurité du contenu peut donc être stricte. Seuls des liens sortants existent (PayPal, mailto).
#
# script-src 'self' : aucun script en ligne dans les pages, tout est dans assets/site.js.
# style-src autorise 'unsafe-inline' parce que les pages utilisent des attributs style= pour
#   quelques ajustements de mise en page. Sans script en ligne, le risque est marginal.
# form-action 'none' : aucun formulaire ne soumet quoi que ce soit ; celui de contact ouvre le
#   logiciel de courriel du visiteur en JavaScript.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# L'installeur : téléchargement forcé plutôt qu'ouverture dans l'onglet, et mise en cache longue
# puisque le nom du fichier porte le numéro de version.
/telechargement/*
  Content-Type: application/octet-stream
  Content-Disposition: attachment
  Cache-Control: public, max-age=31536000, immutable

# Styles et scripts : versionnés à la main, on garde un cache court pour pouvoir corriger vite.
/assets/*
  Cache-Control: public, max-age=3600
